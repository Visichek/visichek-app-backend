# =============================================================================
# VisiChek Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# WARNING: Never commit real credentials. Use a secrets manager in production.
# =============================================================================

# --- Core ---
DB_NAME=visichek
DB_TYPE=mongodb                  # mongodb or sqlite
ENV=development                  # development, testing, production
MONGO_URL=                       # e.g. mongodb://localhost:27017
SECRET_KEY=                      # REQUIRED: JWT signing key (min 32 chars, random)
SESSION_SECRET_KEY=              # REQUIRED: Session middleware key (min 32 chars, random)

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Email ---
# EMAIL_PROVIDER selects the transport: "smtp" (default) or "resend".
# These retry / queue / sender-name settings apply to BOTH providers.
EMAIL_PROVIDER=smtp
EMAIL_SENDER_NAME=VisiChek
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=1.0
EMAIL_QUEUE_ENABLED=true

# --- Email · SMTP transport (EMAIL_PROVIDER=smtp) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=

# --- Email · Resend transport (EMAIL_PROVIDER=resend) ---
# Get the API key at https://resend.com/api-keys. RESEND_FROM_EMAIL must be a
# verified-domain sender (e.g. no-reply@visichek.app); if unset it falls back
# to EMAIL_FROM_EMAIL / EMAIL_USERNAME.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=                  # REQUIRED in production

# --- Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_CUSTOM_WORKER_POOL=celery_aio_pool.pool:AsyncIOPool

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://visichek.app,https://client.visichek.app,https://visichek-app.vercel.app

# --- Frontend base URL ---
# Used to build absolute links in emails (password reset, invites, etc.):
# {APP_BASE_URL}/reset-password?token=... — MUST be set or reset emails
# render without a clickable link. Falls back to the first CORS_ORIGINS
# entry if unset.
APP_BASE_URL=https://client.visichek.app

# --- GeoIP (sessions "Location" column) ---
# Best-effort IP → "City, Region, Country" lookups via ipwho.is, cached
# in Redis (hits 7 days, misses 6 hours). Private/reserved IPs are never
# sent out. Set to false to keep the backend fully offline-capable —
# sessions then show the raw IP as before.
GEOIP_ENABLED=true

# --- Rate Limiting ---
ROLE_RATE_LIMITS=anonymous:20/minute,user:80/minute,admin:140/minute

# --- Storage ---
STORAGE_BACKEND=local            # local or s3
STORAGE_LOCAL_ROOT=uploads
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
# Local storage exposes unauthenticated PUT/GET transport shims; production
# refuses STORAGE_BACKEND=local unless this is explicitly set to true.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# --- Payments ---
PAYMENT_DEFAULT_PROVIDER=stripe  # stripe or flutterwave
# The "app" provider is a checkout SIMULATOR (click-to-confirm). It is
# auto-enabled outside production; in production it is disabled unless this
# break-glass flag is true (and even then, prefer a real provider).
PAYMENT_APP_MODE_ENABLED=false
# Post-payment callback: where the hosted checkout (Paystack/Flutterwave)
# redirects the customer's browser after paying. Point at a FRONTEND page, NOT
# the webhook URL. The provider appends ?reference=...&trxref=... automatically.
# e.g. https://client.visichek.app/app/billing/checkout/return
PAYMENT_CALLBACK_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET_HASH=

# --- Bootstrap Admin ---
# These are used by seed.py to create the initial platform admin.
# REQUIRED: Set a strong password (min 12 chars, mixed case, digits, symbols).
SUPER_ADMIN_EMAIL=               # e.g. admin@yourcompany.com
SUPER_ADMIN_PASSWORD=            # REQUIRED: Strong password

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OCR (optional) ---
OCR_PROVIDER=none                # none, azure, google
OCR_API_KEY=
OCR_API_URL=

# --- QR Code ---
QR_SIGNING_SECRET=               # REQUIRED: Random key for QR HMAC signing

# --- ID encryption ---
ID_NUMBER_ENCRYPTION_KEY=        # REQUIRED in production: encrypts stored ID numbers

# --- OTP ---
# Static dev/break-glass OTP code for the primary admin. Production refuses
# to start if left at the '123456' default — override it with a private value.
OTP_DEV_CODE=123456

# --- Dojah KYC ---
DOJAH_SECRET_KEY=
DOJAH_PUBLIC_KEY=
DOJAH_BASE_URL=                  # optional: defaults by ENV
DOJAH_WEBHOOK_SECRET=            # optional: only if separate from secret key
# v1 is an HMAC over the request BODY; v2 is derived from the secret alone and
# is therefore identical for every payload, so it authenticates nothing about a
# given event. Ignored (forced on) in production — you cannot turn off
# body-bound signing on a live deployment.
DOJAH_REQUIRE_V1_SIGNATURE=true
# Minimum face-match confidence (0-100) between the visitor's selfie and the
# photo on their ID. Below this, the check-in is NOT auto-verified and goes to
# the receptionist with the reason attached. This is what stops someone using a
# genuine ID that isn't theirs. 0 disables the threshold (dev only).
DOJAH_MIN_SELFIE_CONFIDENCE=70
DOJAH_DEBUG_LOG_FULL_PAYLOAD=false # true logs full webhook headers/body/signatures; PII risk

# --- Data Retention ---
RETENTION_CHECK_INTERVAL_HOURS=24

# --- Billing / Dunning ---
MAX_DUNNING_ATTEMPTS=5
DUNNING_RETRY_DAYS=0,3,7,14,21  # Days after first failure for each retry

# --- Backup (optional) ---
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30

# --- Misc ---
SECRETID=
DEFAULT_ADMIN_EMAIL=
LOCATION_API=
DEBUG_INCLUDE_ERROR_DETAILS=false

# --- Self-Onboarding / Cloudflare Turnstile ---
# Server-side secret for verifying Turnstile tokens submitted via
# POST /v1/onboarding/submissions. Leave blank in dev to skip verification.
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Test-email bypass (NON-PRODUCTION ONLY, see core/test_mode.py) ---
# Comma-separated email domains treated as automated-test accounts.
# For these accounts (only when ENV != production): outbound email is
# suppressed, Turnstile on the onboarding form is skipped, and temp
# passwords are the fixed TEST_TEMP_PASSWORD instead of random values.
# Hard no-op in production regardless of these values.
TEST_EMAIL_DOMAINS=e2e.visichek.app
TEST_TEMP_PASSWORD=VisiChekT3st!Pass
